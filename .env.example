WARRANTY_PASS=

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- App-level encryption ----
# Ye key SIRF app server pe. Supabase pe kabhi nahi. Per-dealer key rakhni ho to key-vault me.
ENCRYPTION_KEY=

# ---- WhatsApp (BotSaathi delivery) ----
WABA_TOKEN=
WABA_PHONE_ID=

# ---- Runtime ----
DEFAULT_DEALER_ID=
OWNER_PHONE=
